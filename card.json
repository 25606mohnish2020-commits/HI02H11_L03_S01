    "audio_text": {
      "vo_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
      "vo_pt_practice": "वाह! अब आपकी बारी।",
      "vo_landing": "नमस्ते दोस्त! आज हम मीरा की कविता से एक और अनेक के बदलते शब्द-रूप सीखेंगे।",
      "vo_try_again": "फिर से कोशिश करो।",
      "vo_well_done": "शाबाश! अब तुम जानते हो — गुब्बारा-गुब्बारे, टोपी-टोपियाँ, बच्चा-बच्चे। एक हो तो एकवचन, बहुत सारे हों तो बहुवचन!",
      "vo_mtp_prompt": "एक और अनेक वाले शब्दों की जोड़ियाँ ढूँढ़िए।",
      "vo_mtp_tap": "पहले एक शब्द पर, फिर उसकी जोड़ी पर टैप कीजिए।",
      "vo_mtp_sahi": "यह सही जोड़ी है।",
      "vo_mtp_retry": "फिर से देखिए। इस शब्द की जोड़ी कौन-सी है?",
      "vo_mtp_listen": "इन दोनों शब्दों को सुनिए—",
      "vo_mtp_now_tap": "अब इन पर टैप कीजिए।",
      "vo_mtp_done": "शाबाश! आपने एक और अनेक वाले सभी शब्दों की जोड़ियाँ ढूँढ़ लीं।",
      "vo_w_gubbara_s": "गुब्बारा",
      "vo_w_gubbara_p": "गुब्बारे",
      "vo_w_topi_s": "टोपी",
      "vo_w_topi_p": "टोपियाँ",
      "vo_w_kela_s": "केला",
      "vo_w_kela_p": "केले",
      "vo_w_machli_s": "मछली",
      "vo_w_machli_p": "मछलियाँ",
      "vo_w_ghoda_s": "घोड़ा",
      "vo_w_ghoda_p": "घोड़े",
      "vo_w_saheli_s": "सहेली",
      "vo_w_saheli_p": "सहेलियाँ",
      "vo_stanza1a": "आज है मीरा का जन्मदिन, मीरा ने एक गुब्बारा टाँगा।",
      "vo_stanza1b": "पापा और गुब्बारे लाए, आओ, इन्हें सजाएँ!",
      "vo_stanza_hawa": "तभी हवा का झोंका आया, फुर्र-फुर्र गुब्बारे उड़ते जाएँ!",
      "vo_stanza3a": "एक लड़का उछलकर बोला, मैं पकड़ूँगा सारे!",
      "vo_stanza3b": "फिर लड़के भी दौड़ पड़े— आगे-आगे गुब्बारे!",
      "vo_stanza4a": "मीरा की एक टोपी उड़ी, फिर उड़ीं सबकी टोपियाँ।",
      "vo_stanza4b": "आखिर सबने पकड़ ही लीं, अपनी-अपनी टोपियाँ।",
      "vo_stanza5a": "केक कटा, खुश हुई एक सहेली, झूम-झूम नाची वह अलबेली।",
      "vo_stanza5b": "ताली बजी, गूँजीं खूब तालियाँ, संग-संग नाचीं सारी सहेलियाँ!",
      "vo_cmp_gubbara_1": "मीरा ने एक गुब्बारा टाँगा, पापा और गुब्बारे लाए।",
      "vo_cmp_ladka_1": "एक लड़का उछलकर बोला, फिर लड़के भी दौड़ पड़े।",
      "vo_cmp_topi_1": "मीरा की एक टोपी उड़ी, फिर उड़ीं सबकी टोपियाँ।",
      "vo_cmp_saheli_1": "केक कटा, खुश हुई एक सहेली, संग-संग नाचीं सारी सहेलियाँ!",
      "vo_pick_prompt": "सही शब्द चुनिए।",
      "vo_w_ladki_s": "लड़की",
      "vo_w_ladki_p": "लड़कियाँ",
      "vo_w_paudha_s": "पौधा",
      "vo_w_paudha_p": "पौधे",
      "vo_w_tali_s": "ताली",
      "vo_pick_ok_q1": "शाबाश! आपने सही शब्द चुना — मछलियाँ।",
      "vo_pick_ok_q2": "शाबाश! आपने सही शब्द चुना — लड़कियाँ।",
      "vo_pick_ok_q3": "शाबाश! आपने सही शब्द चुना — टोपी।",
      "vo_pick_ok_q4": "शाबाश! आपने सही शब्द चुना — घोड़े।",
      "vo_pick_ok_q5": "शाबाश! आपने सही शब्द चुना — केले।",
      "vo_pick_ok_q6": "शाबाश! आपने सही शब्द चुना — पौधा।",
      "vo_pick_retry_q1": "फिर से देखिए—यह एक मछली है। अनेक हों, तो क्या कहेंगे?",
      "vo_pick_retry_q2": "फिर से देखिए—यह एक लड़की है। अनेक हों, तो क्या कहेंगे?",
      "vo_pick_retry_q3": "फिर से देखिए—ये अनेक टोपियाँ हैं। एक हो, तो क्या कहेंगे?",
      "vo_pick_retry_q4": "फिर से देखिए—यह एक घोड़ा है। अनेक हों, तो क्या कहेंगे?",
      "vo_pick_retry_q5": "फिर से देखिए—यह एक केला है। अनेक हों, तो क्या कहेंगे?",
      "vo_pick_retry_q6": "फिर से देखिए—ये अनेक पौधे हैं। एक हो, तो क्या कहेंगे?",
      "vo_cmp_topi_2b": "एक है तो टोपी, अनेक है तो टोपियाँ।",
